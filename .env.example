# ── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service-role key — used only by server-side webhooks (Stripe, Phase 1) to
# write past RLS. Keep secret; never expose to the browser. Optional until then.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Anthropic / Claude (required for AI design guides) ───────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Google Gemini (optional — eval only) ────────────────────────────────────
# Used by scripts/eval-guides.mjs to compare guide quality across models. The
# app itself doesn't read this yet; see src/lib/ai/models.ts for the routing
# table that would switch production over. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Stripe (required for billing, Phase 1) ──────────────────────────────────
# Use test-mode keys (sk_test_…) until launch. The webhook secret comes from
# `stripe listen` locally, or the dashboard webhook endpoint in production.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRICE_ID_PRO=your_stripe_pro_price_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Base URL for Stripe checkout/portal return links. Falls back to the request
# origin; set explicitly in production (e.g. https://yourdomain.com).
NEXT_PUBLIC_APP_URL=

# ── Website scanning (production only) ──────────────────────────────────────
# Chromium binary pack for @sparticuz/chromium-min on serverless. If unset, the
# app falls back to the official Sparticuz release pinned in code. Override to
# self-host the pack. Not needed in local dev (uses bundled puppeteer).
CHROMIUM_EXECUTABLE_PATH=

# ── Rate limiting (optional) ────────────────────────────────────────────────
# The built-in limiter is in-memory (per instance). For durable, cross-instance
# rate limiting in production, provide Upstash Redis credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Observability (optional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
